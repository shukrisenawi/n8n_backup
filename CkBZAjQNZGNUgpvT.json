    },
    {
      "parameters": {
        "jsCode": "const data_all = $input.first().json.data;\nconst data_filter = [];\nlet total_data=0;\n\nconst now = new Date();\nconst age_start = $('config').first().json.age_start;\nconst age_last = $('config').first().json.age_last;\n\n// Format YYYY-MM-DD\nlet tarikh = now.toISOString().split(\"T\")[0];\nconst options = { timeZone: \"Asia/Kuala_Lumpur\" };\nconst year = now.toLocaleString(\"en-GB\", { ...options, year: \"numeric\" });\nconst month = now.toLocaleString(\"en-GB\", { ...options, month: \"2-digit\" });\nconst day = now.toLocaleString(\"en-GB\", { ...options, day: \"2-digit\" });\n\nconst tarikh_format = `${day}-${month}-${year}`;\ntarikh =  `${year}-${month}-${day}`;\nconst cek_tarikh_hari_jadi = `${month}-${day}`;\n\n\nfor(const data in data_all){\n  const hari_jadi = data_all[data].date_of_birth.split(\"-\");\n  const tarikh_hari_jadi = `${hari_jadi[1]}-${hari_jadi[2]}`;\n  if(tarikh_hari_jadi==cek_tarikh_hari_jadi && data_all[data].umur>=age_start && data_all[data].umur<=age_last)\n  {\n    data_filter.push(data_all[data]);\n  }\n}\n\nif(data_filter.length>0){\n  total_data= data_filter.length;\n}\n\nreturn [\n  {\n    json:{\n      data_filter,tarikh,tarikh_format,total_data\n    }\n  }\n];"
      },
