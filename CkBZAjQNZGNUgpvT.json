      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n   item.json.message = $('Loop Over Items1').first().json.avatar_url+`PASTI Kawasan Sik mengucapkan 🥳 *SELAMAT HARI JADI* kepada *`+$('Loop Over Items1').first().json.nama.toUpperCase()+`*.\n\n🤲 _Semoga panjang umur dalam keberkatan dan dimurahkan rezeki._`;\n  item.json.sessionId = \"masjid_session\";\n  item.json.group = 'default';\n}\n\nreturn $input.all();"
      },
